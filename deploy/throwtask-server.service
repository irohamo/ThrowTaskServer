[Unit]
Description=ThrowTask API
After=network.target

[Service]
Type=simple
User=throwtask
Group=throwtask
WorkingDirectory=/opt/throwtask-server
ExecStart=/opt/throwtask-server/.venv/bin/throwtask-server --data-dir /var/lib/throwtask --host 127.0.0.1 --port 8766
StateDirectory=throwtask
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/throwtask

[Install]
WantedBy=multi-user.target
