[Unit]
Description=ToiDone API
After=network.target

[Service]
Type=simple
User=toidone
Group=toidone
WorkingDirectory=/opt/toidone-server
ExecStart=/opt/toidone-server/.venv/bin/toidone-server --data-dir /var/lib/toidone --host 127.0.0.1 --port 8766
StateDirectory=toidone
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/toidone

[Install]
WantedBy=multi-user.target
